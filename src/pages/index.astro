---
import Base from "../layouts/Base.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Start from "../components/Start.astro";
import Wakatime from "../components/Wakatime.astro";
import Contact from "../components/Contact.astro";
import Education from "../components/Education.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import TopActionsContainer from "../components/TopActionsContainer.astro";
---

<Base>
<main
    class="h-screen h-dvh overflow-y-scroll snap-none scroll-smooth bg-black text-white overscroll-contain"
    id="scroll-root"
>
        <TopActionsContainer />
        <Start />
        <Projects />
        <Skills />
        <Experience />
        <Education />
        <Wakatime />
        <Contact />
        <ScrollToTop />
    </main>

    <style is:global>
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        h1 {
            text-wrap: balance;
        }
    </style>

    <script>
        import { languages, getLang, type Lang } from "../i18n";
        function updateTexts(lang: Lang, animate = false) {
            const t = languages[lang];
            const elements =
                document.querySelectorAll<HTMLElement>("[data-i18n]");

            elements.forEach((el) => {
                const key = el.dataset.i18n;

                if (!key) return;

                const newText = t[key as keyof typeof t] ?? key;

                // --- 1. Cancelar cualquier animación previa en este elemento ---
                if (el.dataset.timeoutId) {
                    clearTimeout(parseInt(el.dataset.timeoutId));
                }

                if (!animate) {
                    el.textContent = newText;
                    return;
                }

                // --- 2. Lógica de Animación ---
                const isLevelBadge = el.classList.contains(
                    "group-hover:opacity-100",
                );

                if (!el.dataset.originalOpacity) {
                    el.dataset.originalOpacity =
                        window.getComputedStyle(el).opacity;
                }

                el.style.transition = "opacity 0.2s ease, transform 0.2s ease";
                el.style.opacity = "0";
                el.style.transform = "translateY(5px)";

                const mainTimeout = setTimeout(() => {
                    el.textContent = "";

                    if (isLevelBadge) {
                        el.style.opacity = "";
                    } else {
                        if (el.dataset.originalOpacity) {
                            el.style.opacity = el.dataset.originalOpacity;
                        }
                    }

                    el.style.transform = "translateY(0)";

                    let i = 0;
                    const speed = 25;

                    function type() {
                        if (i < newText.length) {
                            el.textContent += newText.charAt(i);
                            i++;
                            const nextStepTimeout = setTimeout(type, speed);
                            el.dataset.timeoutId = nextStepTimeout.toString();
                        } else {
                            el.dataset.timeoutId = "";
                        }
                    }
                    type();
                }, 250);

                el.dataset.timeoutId = mainTimeout.toString();
            });
        }

        // 1. Ejecución inicial: SIN animación
        const currentLang = getLang();
        updateTexts(currentLang, false);

        // 2. Cambio manual: CON animación
        window.addEventListener("language-change", (e: any) => {
            updateTexts(e.detail.lang, true);
        });

        // --- Animaciones de Aparición General (Intro/Skills/Exp) ---
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.remove(
                            "opacity-0",
                            "translate-y-10",
                            "translate-y-12",
                        );
                    }
                });
            },
            { threshold: 0.3 },
        );
        document
            .querySelectorAll("[data-animate]")
            .forEach((el) => observer.observe(el));

        // --- Parallax y Navegación ---
        const root = document.getElementById("scroll-root");
        const parallaxItems = document.querySelectorAll("[data-parallax]");
        if (root) {
            root.addEventListener("scroll", () => {
                const scrollTop = root.scrollTop;
                parallaxItems.forEach((el: any) => {
                    const speed = Number(el.dataset.speed) || 0.2;
                    el.style.transform = `translateY(${scrollTop * speed}px)`;
                });
            });
        }

        // =====================================================
        // Scroll por secciones: rueda + teclado + táctil
        // 1 gesto = 1 sección (instantáneo) + cooldown
        // =====================================================
        const COOLDOWN = 500; // ms entre saltos
        const WHEEL_MIN_DELTA = 4; // ignora ruido mínimo del trackpad
        const SWIPE_MIN = 50; // px mínimos para considerar un swipe
        const EDGE_TOL = 2; // tolerancia de píxeles por redondeos

        let lockedUntil = 0;

        if (root) {
            const getSections = () =>
                Array.from(root.querySelectorAll<HTMLElement>("section[id]"));

            const sectionTop = (el: HTMLElement) =>
                el.getBoundingClientRect().top -
                root.getBoundingClientRect().top +
                root.scrollTop;

            // Sección que contiene el borde superior del viewport
            const getCurrentIndex = (sections: HTMLElement[]) => {
                const atEnd =
                    root.scrollTop + root.clientHeight >=
                    root.scrollHeight - EDGE_TOL;
                if (atEnd) return sections.length - 1;

                let idx = 0;
                sections.forEach((s, i) => {
                    if (sectionTop(s) <= root.scrollTop + EDGE_TOL) idx = i;
                });
                return idx;
            };

            // ¿La sección actual es más alta que la pantalla y aún queda
            // contenido por ver en esa dirección? (típico en móvil)
            const hasRoom = (dir: number) => {
                const sections = getSections();
                if (!sections.length) return false;
                const s = sections[getCurrentIndex(sections)];
                const top = sectionTop(s);
                const bottom = top + s.offsetHeight;
                if (dir > 0) {
                    return bottom - (root.scrollTop + root.clientHeight) > EDGE_TOL;
                }
                return root.scrollTop - top > EDGE_TOL;
            };

            // ¿Hay un hijo con scroll vertical propio que aún puede moverse?
            const canScrollInside = (target: EventTarget | null, dir: number) => {
                let el = target as HTMLElement | null;
                while (el && el !== root) {
                    if (el.nodeType === 1) {
                        const oy = getComputedStyle(el).overflowY;
                        if (
                            (oy === "auto" || oy === "scroll") &&
                            el.scrollHeight > el.clientHeight
                        ) {
                            const atTop = el.scrollTop <= 0;
                            const atBottom =
                                el.scrollTop + el.clientHeight >=
                                el.scrollHeight - 1;
                            if ((dir < 0 && !atTop) || (dir > 0 && !atBottom)) {
                                return true;
                            }
                        }
                    }
                    el = el.parentElement;
                }
                return false;
            };

            const jumpTo = (index: number) => {
                const now = performance.now();
                if (now < lockedUntil) return;

                const sections = getSections();
                const clamped = Math.min(sections.length - 1, Math.max(0, index));
                const target = sections[clamped];
                if (!target) return;

                if (Math.abs(sectionTop(target) - root.scrollTop) <= EDGE_TOL) {
                    return;
                }

                lockedUntil = now + COOLDOWN;
                root.scrollTo({ top: sectionTop(target), behavior: "instant" });
            };

            const go = (dir: number) => {
                const sections = getSections();
                jumpTo(getCurrentIndex(sections) + dir);
            };

            // --- Rueda / trackpad ---
            root.addEventListener(
                "wheel",
                (e: WheelEvent) => {
                    if (e.ctrlKey) return; // zoom del navegador
                    if (Math.abs(e.deltaY) < WHEEL_MIN_DELTA) return;

                    const dir = e.deltaY > 0 ? 1 : -1;
                    if (canScrollInside(e.target, dir)) return;
                    if (hasRoom(dir)) return; // sección alta: scroll nativo

                    e.preventDefault();
                    go(dir);
                },
                { passive: false },
            );

            // --- Teclado ---
            window.addEventListener("keydown", (e: KeyboardEvent) => {
                if (e.defaultPrevented) return;
                if (e.ctrlKey || e.metaKey || e.altKey) return;

                const t = e.target as HTMLElement | null;
                if (
                    t &&
                    (t.isContentEditable ||
                        ["INPUT", "TEXTAREA", "SELECT"].includes(t.tagName))
                ) {
                    return;
                }

                let dir = 0;
                let absolute: "first" | "last" | null = null;

                switch (e.key) {
                    case "ArrowDown":
                    case "PageDown":
                        dir = 1;
                        break;
                    case "ArrowUp":
                    case "PageUp":
                        dir = -1;
                        break;
                    case " ":
                    case "Spacebar":
                        // Espacio sobre botones/enlaces los activa: no tocar
                        if (t?.closest("button, a, summary")) return;
                        dir = e.shiftKey ? -1 : 1;
                        break;
                    case "Home":
                        absolute = "first";
                        break;
                    case "End":
                        absolute = "last";
                        break;
                    default:
                        return;
                }

                if (absolute) {
                    e.preventDefault();
                    const sections = getSections();
                    jumpTo(absolute === "first" ? 0 : sections.length - 1);
                    return;
                }

                if (canScrollInside(t, dir)) return;
                if (hasRoom(dir)) return; // deja el scroll nativo

                e.preventDefault();
                go(dir);
            });

            // --- Táctil (móvil / tablet) ---
            let touchStartX = 0;
            let touchStartY = 0;
            let touchTarget: EventTarget | null = null;
            let touchNative = false; // el gesto lo resolvió el navegador

            root.addEventListener(
                "touchstart",
                (e: TouchEvent) => {
                    const t = e.touches[0];
                    touchStartX = t.clientX;
                    touchStartY = t.clientY;
                    touchTarget = e.target;
                    touchNative = false;
                },
                { passive: true },
            );

            root.addEventListener(
                "touchmove",
                (e: TouchEvent) => {
                    const t = e.touches[0];
                    const dx = touchStartX - t.clientX;
                    const dy = touchStartY - t.clientY;

                    // Solo gestos mayormente verticales
                    if (Math.abs(dy) < Math.abs(dx)) return;
                    if (Math.abs(dy) < 4) return;

                    const dir = dy > 0 ? 1 : -1;

                    if (canScrollInside(touchTarget, dir) || hasRoom(dir)) {
                        touchNative = true; // deja que el navegador haga scroll
                        return;
                    }

                    // Evita el scroll nativo/rebote: el salto se hace en touchend
                    if (e.cancelable) e.preventDefault();
                },
                { passive: false },
            );

            root.addEventListener(
                "touchend",
                (e: TouchEvent) => {
                    if (touchNative) return;

                    const t = e.changedTouches[0];
                    const dx = touchStartX - t.clientX;
                    const dy = touchStartY - t.clientY;

                    if (Math.abs(dy) < SWIPE_MIN) return;
                    if (Math.abs(dy) < Math.abs(dx) * 1.2) return;

                    go(dy > 0 ? 1 : -1);
                },
                { passive: true },
            );
        }

        // 1. Manejar el scroll automático al cargar
        window.addEventListener("load", () => {
            const hash = window.location.hash;
            if (hash) {
                const targetSection = document.querySelector(hash);
                if (targetSection)
                    targetSection.scrollIntoView({ behavior: "smooth" });
            }
        });

        // 2. Observer para actualizar la URL
        const urlObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting && entry.target.id) {
                        history.replaceState(null, "", `#${entry.target.id}`);
                    }
                });
            },
            { threshold: 0.6 },
        );

        document
            .querySelectorAll("section[id]")
            .forEach((section) => urlObserver.observe(section));

        // Scroll instantáneo al hash inicial
        if (window.location.hash) {
            document
                .querySelector(window.location.hash)
                ?.scrollIntoView({ behavior: "instant" });
        }
    </script>
</Base>
