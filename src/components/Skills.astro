---
enum Level {
    Junior = "junior",
    Intermediate = "intermediate",
    Advanced = "advanced",
    Expert = "expert",
    Master = "master",
}

// Clases estáticas (Tailwind necesita verlas completas en el código)
const gridCols: Record<number, string> = {
    7: "md:grid-cols-7",
    4: "md:grid-cols-4",
    3: "md:grid-cols-3",
};
const colSpan: Record<number, string> = {
    7: "md:col-span-7",
    4: "md:col-span-4",
    3: "md:col-span-3",
};

// Cada fila es un grupo de categorías. En escritorio todas las tiles se
// alinean en una rejilla de 7 columnas; en móvil son 4 columnas.
const rows = [
    [
        {
            label: "skills_frontend",
            color: "from-blue-500",
            span: 7,
            items: [
                { name: "JavaScript", icon: "javascript", percent: 90, level: Level.Expert },
                { name: "TypeScript", icon: "typescript", percent: 85, level: Level.Expert },
                { name: "React", icon: "react", percent: 90, level: Level.Advanced },
                { name: "Tailwind", icon: "tailwindcss", percent: 80, level: Level.Advanced },
                { name: "Astro", icon: "astro", percent: 60, level: Level.Intermediate },
                { name: "Bootstrap", icon: "bootstrap", percent: 60, level: Level.Intermediate },
                { name: "Angular", icon: "angular", percent: 55, level: Level.Intermediate },
            ],
        },
    ],
    [
        {
            label: "skills_backend",
            color: "from-emerald-500",
            span: 7,
            items: [
                { name: "Node.js", icon: "nodedotjs", percent: 80, level: Level.Advanced },
                { name: "MySQL", icon: "mysql", percent: 90, level: Level.Expert },
                { name: "PostgreSQL", icon: "postgresql", percent: 60, level: Level.Intermediate },
                { name: "Redis", icon: "redis", percent: 90, level: Level.Expert },
                { name: "Django", icon: "django", percent: 80, level: Level.Advanced },
                { name: "GraphQL", icon: "graphql", percent: 90, level: Level.Advanced },
                { name: "Spring", icon: "spring", percent: 95, level: Level.Expert },
            ],
        },
    ],
    [
        {
            label: "skills_devops",
            color: "from-purple-500",
            span: 4,
            items: [
                { name: "Docker", icon: "docker", percent: 95, level: Level.Expert },
                { name: "Git", icon: "git", percent: 90, level: Level.Expert },
                { name: "GitHub Actions", icon: "githubactions", percent: 90, level: Level.Expert },
                { name: "Postman", icon: "postman", percent: 80, level: Level.Advanced },
            ],
        },
        {
            label: "skills_embedded",
            color: "from-orange-500",
            span: 3,
            items: [
                { name: "Arduino", icon: "arduino", percent: 60, level: Level.Intermediate },
                { name: "Rust", icon: "rust", percent: 55, level: Level.Intermediate },
            ],
        },
    ],
];
---

<section
    class="snap-start min-h-[100dvh] md:h-[100dvh] relative flex items-center bg-[#030303] light:bg-[#f9fafb] overflow-hidden transition-colors duration-700"
    id="skills"
>
    <div
        id="particles-container"
        class="absolute inset-0 z-0 pointer-events-none opacity-40 light:opacity-20 transition-opacity duration-700 theme-perf-target"
    >
    </div>

    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-500/10 light:bg-indigo-500/5 blur-[120px] rounded-full pointer-events-none z-0 transition-colors duration-700 theme-perf-target"
    >
    </div>

    <div class="skills-wrap container mx-auto px-6 md:px-12 relative z-10 pt-12 pb-4 md:py-0">
        <div
            class="opacity-0 translate-y-10 transition-all duration-1000 ease-out"
            data-animate
        >
            <h2
                data-i18n="skills"
                class="skills-title text-3xl md:text-6xl font-black mb-3 md:mb-8 tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-white to-white/30 light:from-gray-900 light:to-gray-400 transition-colors duration-700"
            >
                Habilidades
            </h2>

            <div class="skills-stack flex flex-col gap-3 md:gap-8">
                {
                    rows.map((row) => (
                        <div class="flex flex-col gap-3 md:grid md:grid-cols-7 md:gap-4">
                            {row.map((category) => (
                                <div class={colSpan[category.span]}>
                                    <h3
                                        data-i18n={category.label}
                                        class="text-[10px] md:text-xs uppercase tracking-[0.3em] text-indigo-400 light:text-indigo-600 font-bold mb-2 md:mb-3 ml-1 transition-colors duration-700"
                                    />

                                    <div
                                        class={`grid grid-cols-4 ${gridCols[category.span]} gap-1.5 md:gap-4`}
                                    >
                                        {category.items.map((skill) => (
                                            <div
                                                class="group relative p-[1px] rounded-lg md:rounded-xl overflow-hidden transition-all duration-700 hover:scale-105"
                                                style={`--skill-percent: ${skill.percent}%;`}
                                            >
                                                <div
                                                    class={`absolute inset-0 bg-gradient-to-br ${category.color} to-transparent opacity-10 light:opacity-20 group-hover:opacity-100 transition-all duration-700`}
                                                />

                                                <div class="skill-body relative bg-neutral-900/90 light:bg-white/90 backdrop-blur-xl pt-2 pb-3 px-1 md:pt-4 md:pb-6 md:px-3 rounded-lg md:rounded-xl h-full flex flex-col items-center justify-center border border-white/5 light:border-black/5 shadow-2xl text-center transition-all duration-700">
                                                    <img
                                                        src={`https://cdn.simpleicons.org/${skill.icon}/white`}
                                                        alt={skill.name + " icon"}
                                                        class="skill-icon w-5 h-5 md:w-7 md:h-7 mb-0.5 md:mb-2 opacity-50 light:opacity-80 light:invert group-hover:opacity-0 group-hover:scale-50 transition-all duration-500"
                                                    />

                                                    <span
                                                        data-i18n={skill.level}
                                                        class="absolute top-2 md:top-4 opacity-0 scale-50 group-hover:opacity-100 group-hover:scale-100 transition-all duration-500 text-indigo-400 light:text-indigo-600 font-mono text-[8px] md:text-[10px] uppercase tracking-tighter"
                                                    >
                                                        {skill.level}
                                                    </span>

                                                    <span class="text-[9px] md:text-sm font-bold tracking-tight text-gray-400 light:text-gray-600 group-hover:text-white light:group-hover:text-black transition-colors duration-500 line-clamp-1">
                                                        {skill.name}
                                                    </span>

                                                    <div class="absolute bottom-1.5 md:bottom-3 left-1/2 -translate-x-1/2 w-10 md:w-16 h-[2px] bg-white/10 light:bg-black/10 rounded-full overflow-hidden opacity-0 group-hover:opacity-100 transition-opacity duration-700">
                                                        <div
                                                            class={`h-full bg-gradient-to-r ${category.color} to-white light:to-indigo-500 transition-all duration-1000 ease-out w-0 group-hover:w-[var(--skill-percent)]`}
                                                        />
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes pulse {
        0%,
        100% {
            transform: scale(1);
            opacity: 0.2;
        }
        50% {
            transform: scale(1.5);
            opacity: 0.7;
        }
    }

    /* Móviles bajitos (iPhone SE, navegador con barras): aprieta un poco más
       para que todo siga entrando en una sola pantalla */
    @media (max-width: 767px) and (max-height: 640px) {
        .skills-wrap {
            padding-top: 2.75rem;
            padding-bottom: 0.5rem;
        }
        .skills-title {
            font-size: 1.5rem;
            line-height: 1.75rem;
            margin-bottom: 0.5rem;
        }
        .skills-stack {
            gap: 0.5rem;
        }
        .skill-body {
            padding-top: 0.25rem;
            padding-bottom: 0.625rem;
        }
        .skill-icon {
            width: 1rem;
            height: 1rem;
            margin-bottom: 0;
        }
    }
</style>

<script>
    const container = document.getElementById("particles-container");
    if (container) {
        container.innerHTML = "";
        for (let i = 0; i < 40; i++) {
            const p = document.createElement("div");
            p.className =
                "absolute bg-white light:bg-gray-400 rounded-full transition-colors duration-700";
            const size = Math.random() * 2 + 1 + "px";
            p.style.width = size;
            p.style.height = size;
            p.style.top = Math.random() * 100 + "%";
            p.style.left = Math.random() * 100 + "%";
            p.style.opacity = (Math.random() * 0.5 + 0.2).toString();
            p.style.animation = `pulse ${Math.random() * 3 + 2}s infinite ease-in-out`;
            container.appendChild(p);
        }
    }
</script>